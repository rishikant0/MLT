# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mlt-learning-zone?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your-secure-jwt-secret-key-32chars
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-key-32chars

# Admin Account Credentials (Seeded into DB)
ADMIN_EMAIL=rishikant.aws27@gmail.com
ADMIN_PASSWORD=your-strong-admin-password

# Email Notifications Configuration (SMTP / Gmail App Password)
EMAIL_USER=rishikant.aws27@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM="MLT Learning Zone" <rishikant.aws27@gmail.com>

# Application URLs
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Local Upload Directory
UPLOAD_DIR=./uploads

# Payment System Settings
UPI_ID=mltlearningzone@upi
UPI_NAME=MLT Learning Zone

# Razorpay Configuration (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
